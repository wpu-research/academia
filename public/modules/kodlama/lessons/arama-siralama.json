   "code": "def hizli(liste):\n    if len(liste) <= 1:\n        return liste\n    pivot = liste[0]\n    kucuk = [x for x in liste[1:] if x < pivot]\n    buyuk = [x for x in liste[1:] if x >= pivot]\n    return hizli(kucuk) + [pivot] + hizli(buyuk)\n\nprint(hizli([5, 3, 8, 1]))",
